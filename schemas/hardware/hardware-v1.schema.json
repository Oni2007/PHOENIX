    "ComputeUnit": {
      "additionalProperties": false,
      "description": "Deliberately generic: an SM, a CU, an MXU, and an MZI mesh have nothing\nstructurally in common, so this is a list of typed records, not fixed keys\n(TDD \u00a79.3) \u2014 the same shape describes every future backend, not just GPUs.",
      "properties": {
        "count": {
          "$ref": "#/$defs/ProvenanceValue"
        },
        "generation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Generation"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "count"
      ],
      "title": "ComputeUnit",
      "type": "object"
    },
