    "PeakComputeValue": {
      "additionalProperties": false,
      "description": "A peak throughput/bandwidth figure (TDD \u00a79.1).\n\n'conditions is mandatory on all peak-compute fields... the schema rejects a\npeak-compute entry lacking conditions.' A peak FLOP/s figure without stated\nconditions (sparsity on/off, boost vs base clock, which precision mode) is\nthe single most common source of dishonest accelerator comparisons. This is\nthe one line in the TDD that is worth enforcing by type rather than review.",
      "properties": {
        "conditions": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Conditions"
        },
        "confidence": {
