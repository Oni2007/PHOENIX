{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PHOENIX RunRequest v1",
  "description": "The exact object that crosses the Python -> C++ boundary. Stored verbatim in every reproducibility package so the request that produced a result is recoverable byte-for-byte.",
  "type": "object",
  "required": ["schema_version", "experiment_id", "backend", "implementation", "workload"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "experiment_id": {"type": "string"},
    "backend": {"type": "string"},
    "implementation": {"type": "string"},
    "workload": {
      "type": "object",
      "required": ["kind", "M", "N", "K"],
      "additionalProperties": false,
      "properties": {
        "kind": {"const": "GEMM"},
        "M": {"type": "integer", "minimum": 1},
        "N": {"type": "integer", "minimum": 1},
        "K": {"type": "integer", "minimum": 1},
        "dtype_a": {"enum": ["fp32", "fp64"]},
        "dtype_b": {"enum": ["fp32", "fp64"]},
        "dtype_c": {"enum": ["fp32", "fp64"]},
        "dtype_compute": {"enum": ["fp32", "fp64"]},
        "alpha": {"type": "number"},
        "beta": {"type": "number"},
        "seed": {"type": "integer", "minimum": 0}
      }
    },
    "measurement": {"type": "object"},
    "correctness": {"type": "object"}
  }
}
